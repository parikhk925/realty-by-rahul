# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Supabase Auth + Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. Never expose this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Demo studio — set to "true" to open the agent studio without Supabase.
# Never set this on a deployment holding real customer data.
DEMO_STUDIO=

# WhatsApp Cloud API. Leave blank to keep WhatsApp disconnected.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Second interlock: credentials alone will not start sending.
WHATSAPP_ENABLE_SENDING=
